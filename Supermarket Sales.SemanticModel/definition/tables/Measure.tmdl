table Measure
	lineageTag: f2d08def-35b9-4577-8d33-32e449ecb5b2

	measure #TotalSales = SUMX(FactSales,FactSales[Cantidad]*RELATED(DimProducts[Precio_Unit]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: KPIs
		lineageTag: e056b0f8-eec9-447f-8293-243ecea333b3

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure #TotalBudget =
			
			VAR SelectedBranch = SELECTEDVALUE(DimBranch[Id_Tienda])
			VAR ppto = SUMX(FILTER(FactSalesVsPPTO,FactSalesVsPPTO[Id_Tienda]=SelectedBranch),FactSalesVsPPTO[Presupuesto])
			RETURN IF(ISBLANK(ppto),SUMX(FactSalesVsPPTO,FactSalesVsPPTO[Presupuesto]),ppto)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: KPIs
		lineageTag: 3da745b5-c4da-4f17-bb08-8003d9c150d1

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure #%Goal =
			
			VAR _goal = DIVIDE([#TotalSales],[#TotalBudget],0)
			VAR _result = IF(_goal>1,1,_goal)
			RETURN _result
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: KPIs
		lineageTag: c4c784ec-33b1-4d27-952b-07ce893361d1

	measure #%GoalTarget = 1
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: KPIs
		lineageTag: 9ab1a021-540b-43fb-831d-ae6deb18289c

	measure CardSales_Budget = ```
			
			
			VAR bg = MAXX(Mode,Mode[BgVisual])
			VAR _textmain = IF(SELECTEDVALUE(Mode[Activo])=0,MAXX(Mode,Mode[TextoPrincipal]),"#00ffcc")
			VAR _textsec = MAXX(Mode,Mode[TextoPrincipal])
			VAR bordecard = IF(SELECTEDVALUE(Mode[Activo])=0,_textsec,bg)
			VAR ingresoslogo = IF(SELECTEDVALUE(Mode[Activo])=0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/IngresosLight.png","https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/IngresosDark.png")
			VAR pptologo = IF(SELECTEDVALUE(Mode[Activo])=0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ObjetivoLight.png","https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ObjetivoDark.png")
			VAR ingresos = [TotalSalesFormat]
			VAR ppto = [TotalBudgetFormat]
			VAR textfront = "Sales"
			VAR textback = "Budget"
			
			RETURN
			"
			<head>
			 <style>
			.card {
			  width: 270px;
			  height: 150px;
			  perspective: 1000px;
			}
			
			.card-inner {
			  width: 100%;
			  height: 100%;
			  position: relative;
			  transform-style: preserve-3d;
			  transition: transform 0.999s;
			}
			
			.card:hover .card-inner {
			  transform: rotateY(180deg);
			}
			
			.card-front,
			.card-back {
			  position: absolute;
			  width: 100%;
			  height: 100%;
			  backface-visibility: hidden;
			  display: flex;
			  flex-direction: column;
			}
			
			.card-front {
			  background-color: "&bg&";
			  color: #fff;
			  display: flex;
			  align-items: center;
			  border: 1px solid "&bordecard&";
			  border-radius: 10px;
			  justify-content: center;
			  transform: rotateY(0deg);
			}
			
			.card-back {
			  background-color: "&bg&";
			  color: #fff;
			  display: flex;
			  align-items: center;
			  border: 1px solid "&bordecard&";
			  border-radius: 10px;
			  justify-content: center;
			  transform: rotateY(180deg);
			}
			
			p {
			  font-size: 0.8rem;
			  display: flex;
			  flex-direction: row;
			  justify-content: center;
			  align-items: center;
			  gap: 5px;
			  color: "&_textsec&";
			}
			
			h3 {
			  color:"&_textmain&";
			  font-weight: bold;
			}
			
			
			 </style>   
			</head>
			<div class='card'>
			  <div class='card-inner'>
			    <div class='card-front'>
			      <h3>"&ingresos&"</h3>
			      <p><img src='"&ingresoslogo&"' width='26px'>"&textfront&"</p>
			    </div>
			    <div class='card-back'>
			      <h3>"&ppto&"</h3>
			      <p><img src='"&pptologo&"' width='26px'>"&textback&"</p>
			    </div>
			  </div>
			</div>
			"
			```
		displayFolder: VisualesHTML
		lineageTag: 5acc75f5-2995-4b8a-9f2e-9c8629266bca

