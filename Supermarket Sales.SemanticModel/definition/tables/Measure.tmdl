	measure #AverageTicket =
			
			VAR transactions = DISTINCTCOUNT(FactSales[Id_transaccion])
			RETURN DIVIDE([#TotalSales],transactions,0)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: KPIs
		lineageTag: cdba6eb4-fcf9-43d7-8231-ea21a780cab7

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure CardAverageTicket_GAPSelling = ```
			
			
			VAR bg = MAXX(Mode,Mode[BgVisual])
			var _textsec = MAXX(Mode,Mode[TextoPrincipal])
			VAR _textmain = IF(SELECTEDVALUE(Mode[Activo])=0,MAXX(Mode,Mode[TextoPrincipal]),"#00ffcc")
			VAR bordecard = IF(SELECTEDVALUE(Mode[Activo])=0,_textsec,bg)
			VAR ticketlogo = IF(SELECTEDVALUE(Mode[Activo])=0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/TicketLight.png","https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/TicketDark.png")
			VAR gaplogo =
			    SWITCH(TRUE(),
			    SELECTEDVALUE(Mode[Activo])=0 && [#GAPSelling]>0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ArribaLight.png",
			    SELECTEDVALUE(Mode[Activo])=0 && [#GAPSelling]<0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/AbajoLight.png",
			    SELECTEDVALUE(Mode[Activo])=1 && [#GAPSelling]>0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ArribaDark.png",
			    SELECTEDVALUE(Mode[Activo])=1 && [#GAPSelling]<0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/AbajoDark.png",
			    SELECTEDVALUE(Mode[Activo])=0 && [#GAPSelling]=0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/FlechaLight.png",
			    SELECTEDVALUE(Mode[Activo])=1 && [#GAPSelling]=0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/FlechaDark.png")
			VAR ticket = [AverageTicketFormat]
			VAR gap = [GAPFormat]
			VAR textfront = "Average Ticket"
			VAR textback = "GAP Selling"
			
			RETURN
			"
			<head>
			 <style>
			.card {
			  width: 270px;
			  height: 150px;
			  perspective: 1000px;
			}
			
			.card-inner {
			  width: 100%;
			  height: 100%;
			  position: relative;
			  transform-style: preserve-3d;
			  transition: transform 0.999s;
			}
			
			.card:hover .card-inner {
			  transform: rotateY(180deg);
			}
			
			.card-front,
			.card-back {
			  position: absolute;
			  width: 100%;
			  height: 100%;
			  backface-visibility: hidden;
			  display: flex;
			  flex-direction: column;
			}
			
			.card-front {
			  background-color: "&bg&";
			  color: #fff;
			  display: flex;
			  align-items: center;
			  border: 1px solid "&bordecard&";
			  border-radius: 10px;
			  justify-content: center;
			  transform: rotateY(0deg);
			}
			
			.card-back {
			  background-color: "&bg&";
			  color: #fff;
			  display: flex;
			  align-items: center;
			  border: 1px solid "&bordecard&";
			  border-radius: 10px;
			  justify-content: center;
			  transform: rotateY(180deg);
			}
			
			p {
			  font-size: 0.8rem;
			  display: flex;
			  flex-direction: row;
			  justify-content: center;
			  align-items: center;
			  gap: 5px;
			  color: "&_textsec&";
			}
			
			h3 {
			  color:"&_textmain&";
			  font-weight: bold;
			}
			
			
			 </style>   
			</head>
			<div class='card'>
			  <div class='card-inner'>
			    <div class='card-front'>
			      <h3>"&ticket&"</h3>
			      <p><img src='"&ticketlogo&"' width='26px'>"&textfront&"</p>
			    </div>
			    <div class='card-back'>
			      <h3>"&[GAPFormat]&"</h3>
			      <p><img src='"&gaplogo&"' width='26px'>"&textback&"</p>
			    </div>
			  </div>
			</div>
			"
			```
