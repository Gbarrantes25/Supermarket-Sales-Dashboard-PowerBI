	measure #%ActiveCustomers = ```
			
				VAR referencedate = LASTDATE(ALL(FactSales[Fecha]))
				VAR startdate = referencedate - 90
				VAR result = CALCULATE(
					DISTINCTCOUNT(FactSales[Id_Cliente]),
					FactSales[Fecha] >= startdate
				)
				VAR customers = DISTINCTCOUNT(FactSales[Id_Cliente])
			
			
				RETURN
					DIVIDE(result,customers,0)
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: KPIs
		lineageTag: e7c57dfe-ad22-4421-9f18-911f921ac9da

	measure #CustomersPortfolio =
			
			VAR ReferenceDate = LASTDATE(ALL(FactSales[Fecha]))
			VAR StartDate = ReferenceDate-90
			VAR Customers = CALCULATE(DISTINCTCOUNT(FactSales[Id_Cliente]),FactSales[Fecha]<StartDate)
			RETURN Customers
		formatString: 0
		displayFolder: KPIs
		lineageTag: b7ce3810-c6d2-43f1-acb5-49fdbb51430e

	measure #NewCustomers =
			
			VAR ReferenceDate = LASTDATE(ALL(FactSales[Fecha]))
			VAR Stardate = ReferenceDate-90
			VAR tbtlongtimecustomers = CALCULATETABLE(VALUES(FactSales[Id_Cliente]),FactSales[Fecha]<Stardate)
			VAR tbtactivecustomers = CALCULATETABLE(VALUES(FactSales[Id_Cliente]),FactSales[Fecha]>=Stardate)
			VAR tbtnewcustomers = COUNTROWS(EXCEPT(tbtactivecustomers,tbtlongtimecustomers))
			RETURN tbtnewcustomers
		formatString: 0
		displayFolder: KPIs
		lineageTag: 692526e1-0d74-4ccf-bb53-a089d6f2fea8

	measure CardClientesAntiguos_Nuevos = ```
			
			VAR bg = MAXX(Mode,Mode[BgVisual])
			var _textsec = MAXX(Mode,Mode[TextoPrincipal])
			VAR _textmain = IF(SELECTEDVALUE(Mode[Activo])=0,MAXX(Mode,Mode[TextoPrincipal]),"#00ffcc")
			VAR bordecard = IF(SELECTEDVALUE(Mode[Activo])=0,_textsec,bg)
			VAR CustomerPortfolioLogo = IF(SELECTEDVALUE(Mode[Activo])=0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ClientesAntiguosLight.png","https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ClientesAntiguosDark.png")
			VAR NewCustomerLogo = IF(SELECTEDVALUE(Mode[Activo])=0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ClienteNuevoLight.png","https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ClienteNuevoDark.png")
			
			VAR CustomerPortfolio = [#CustomersPortfolio]
			VAR NewCustomers = [#NewCustomers]
			VAR textfront = "Customer portfolio"
			VAR textback = "New Customers"
			
			RETURN
			"
			<head>
			 <style>
			.card {
			  width: 230px;
			  height: 280px;
			  perspective: 1000px;
			}
			
			.card-inner {
			  width: 100%;
			  height: 100%;
			  position: relative;
			  transform-style: preserve-3d;
			  transition: transform 0.999s;
			}
			
			.card:hover .card-inner {
			  transform: rotateY(180deg);
			}
			
			.card-front,
			.card-back {
			  position: absolute;
			  width: 100%;
			  height: 100%;
			  backface-visibility: hidden;
			  display: flex;
			  flex-direction: column;
			}
			
			.card-front {
			  background-color: "&bg&";
			  color: #fff;
			  display: flex;
			  align-items: center;
			  border: 1px solid "&bordecard&";
			  border-radius: 10px;
			  justify-content: center;
			  transform: rotateY(0deg);
			}
			
			.card-back {
			  background-color: "&bg&";
			  color: #fff;
			  display: flex;
			  align-items: center;
			  border: 1px solid "&bordecard&";
			  border-radius: 10px;
			  justify-content: center;
			  transform: rotateY(180deg);
			}
			
			p {
			  font-size: 0.8rem;
			  display: flex;
			  flex-direction: row;
			  justify-content: center;
			  align-items: center;
			  gap: 5px;
			  color: "&_textsec&";
			}
			
			h3 {
			  color:"&_textmain&";
			  font-weight: bold;
			}
			
			
			 </style>   
			</head>
			<div class='card'>
			  <div class='card-inner'>
			    <div class='card-front'>
			      <h3>"&CustomerPortfolio&"</h3>
			      <p><img src='"&CustomerPortfolioLogo&"' width='26px'>"&textfront&"</p>
			    </div>
			    <div class='card-back'>
			      <h3>"&NewCustomers&"</h3>
			      <p><img src='"&NewCustomerLogo&"' width='26px'>"&textback&"</p>
			    </div>
			  </div>
			</div>
			"
			```
		displayFolder: VisualesHTML
		lineageTag: e2158f63-b566-478e-b422-01adb9aa2061

	measure #InactiveCustomers = ```
			
				VAR referencedate = LASTDATE(ALL(FactSales[Fecha]))
				VAR startdate = referencedate - 90
				VAR result = CALCULATE(
					DISTINCTCOUNT(FactSales[Id_Cliente]),
					FactSales[Fecha] >= startdate
				)
				VAR customers = DISTINCTCOUNT(FactSales[Id_Cliente])
			
			
				RETURN customers-result
			```
		formatString: 0
		displayFolder: KPIs
		lineageTag: 997419ed-0a39-4957-9bf1-69a1b1421ced

	measure CardClientesInactivos_%Activos = ```
			
			VAR bg = MAXX(Mode,Mode[BgVisual])
			var _textsec = MAXX(Mode,Mode[TextoPrincipal])
			VAR _textmain = IF(SELECTEDVALUE(Mode[Activo])=0,MAXX(Mode,Mode[TextoPrincipal]),"#00ffcc")
			VAR bordecard = IF(SELECTEDVALUE(Mode[Activo])=0,_textsec,bg)
			VAR CustomerActivoLogo = IF(SELECTEDVALUE(Mode[Activo])=0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ClientesActivosLight.png","https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ClientesActivosDark.png")
			VAR CustomerInactivoLogo = IF(SELECTEDVALUE(Mode[Activo])=0,"https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ClientesInactivosLight.png","https://raw.githubusercontent.com/Gbarrantes25/Supermarket-Sales-Dashboard/refs/heads/main/Images/ClientesInactivosDark.png")
			
			VAR _ClientesActivos = FORMAT([#%ActiveCustomers],"0.00%","En-Us")
			VAR _CLientesInactivos = [#InactiveCustomers]
			VAR textfront = "Active Customer (%)"
			VAR textback = "Inactive Customer"
			
			RETURN
			"
			<head>
			 <style>
			.card {
			  width: 230px;
			  height: 280px;
			  perspective: 1000px;
			}
			
			.card-inner {
			  width: 100%;
			  height: 100%;
			  position: relative;
			  transform-style: preserve-3d;
			  transition: transform 0.999s;
			}
			
			.card:hover .card-inner {
			  transform: rotateY(180deg);
			}
			
			.card-front,
			.card-back {
			  position: absolute;
			  width: 100%;
			  height: 100%;
			  backface-visibility: hidden;
			  display: flex;
			  flex-direction: column;
			}
			
			.card-front {
			  background-color: "&bg&";
			  color: #fff;
			  display: flex;
			  align-items: center;
			  border: 1px solid "&bordecard&";
			  border-radius: 10px;
			  justify-content: center;
			  transform: rotateY(0deg);
			}
			
			.card-back {
			  background-color: "&bg&";
			  color: #fff;
			  display: flex;
			  align-items: center;
			  border: 1px solid "&bordecard&";
			  border-radius: 10px;
			  justify-content: center;
			  transform: rotateY(180deg);
			}
			
			p {
			  font-size: 0.8rem;
			  display: flex;
			  flex-direction: row;
			  justify-content: center;
			  align-items: center;
			  gap: 5px;
			  color: "&_textsec&";
			}
			
			h3 {
			  color:"&_textmain&";
			  font-weight: bold;
			}
			
			
			 </style>   
			</head>
			<div class='card'>
			  <div class='card-inner'>
			    <div class='card-front'>
			      <h3>"&_ClientesActivos&"</h3>
			      <p><img src='"&CustomerActivoLogo&"' width='26px'>"&textfront&"</p>
			    </div>
			    <div class='card-back'>
			      <h3>"&_CLientesInactivos&"</h3>
			      <p><img src='"&CustomerInactivoLogo&"' width='26px'>"&textback&"</p>
			    </div>
			  </div>
			</div>
			"
			```
		displayFolder: VisualesHTML
		lineageTag: bba97662-0fda-43db-a5e2-d3330c8e75b8

